ARG CUDA_VERSION=notset
# NVIDIA's minimal build toolkit omits the large math libraries and profilers.
FROM nvcr.io/nvidia/cuda:$CUDA_VERSION-base-rockylinux8
ARG CUDA_VERSION
ARG NCCL_VERSION
ARG RAPIDS_VERSION
ARG ARCH=x86_64
ARG MINIFORGE_VERSION=26.3.2-3
ARG CMAKE_VERSION=4.1.0

SHELL ["/bin/bash", "-c"]

ENV PATH=/opt/miniforge/bin:/usr/local/ninja:$PATH
ENV CC=/opt/rh/gcc-toolset-14/root/usr/bin/gcc
ENV CXX=/opt/rh/gcc-toolset-14/root/usr/bin/c++
ENV CPP=/opt/rh/gcc-toolset-14/root/usr/bin/cpp
ENV CUDAHOSTCXX=/opt/rh/gcc-toolset-14/root/usr/bin/c++
ENV GOSU_VERSION=1.10

COPY scripts/setup_cuda_rockylinux.sh scripts/install_gosu.sh /scripts/

# Install all basic requirements
RUN \
    CUDA_SHORT=$(echo "${CUDA_VERSION%.*}" | tr . -) && \
    # Allow patch updates within this CUDA minor release, then lock the resolved toolkit.
    bash /scripts/setup_cuda_rockylinux.sh \
      cuda-minimal-build-${CUDA_SHORT} cuda-nvml-devel-${CUDA_SHORT} cuda-nvtx-${CUDA_SHORT} && \
    dnf install -y findutils tar unzip wget xz git which ninja-build gcc-toolset-14-gcc gcc-toolset-14-binutils gcc-toolset-14-gcc-c++ && \
    # Clean in the installation layer; later deletions cannot shrink an earlier layer.
    dnf clean all && rm -rf /var/cache/dnf && \
    # Miniforge
    wget -nv -O conda.sh https://github.com/conda-forge/miniforge/releases/download/$MINIFORGE_VERSION/Miniforge3-$MINIFORGE_VERSION-Linux-${ARCH}.sh && \
    bash conda.sh -b -p /opt/miniforge && \
    rm conda.sh && \
    /opt/miniforge/bin/python -m pip install --no-cache-dir awscli && \
    # Miniforge uses hard links here, so the installed environment survives cache removal.
    /opt/miniforge/bin/mamba clean --all --yes && \
    rm -rf /opt/miniforge/pkgs && \
    # CMake
    wget -nv -O cmake.sh https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-${ARCH}.sh && \
    bash cmake.sh --skip-license --prefix=/usr && \
    rm cmake.sh

# NCCL2 (License: https://docs.nvidia.com/deeplearning/sdk/nccl-sla/index.html)
RUN \
    { [ $ARCH = "aarch64" ] && export CUDA_REPO_ARCH="sbsa" || export CUDA_REPO_ARCH="x86_64"; } && \
    export CUDA_SHORT=`echo $CUDA_VERSION | grep -o -E '[0-9]+\.[0-9]'` && \
    export NCCL_VERSION=$NCCL_VERSION && \
    dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel8/${CUDA_REPO_ARCH}/cuda-rhel8.repo && \
    # System packages were already updated by setup_cuda_rockylinux.sh.
    dnf install -y libnccl-${NCCL_VERSION}+cuda${CUDA_SHORT} libnccl-devel-${NCCL_VERSION}+cuda${CUDA_SHORT} && \
    dnf clean all && rm -rf /var/cache/dnf

# Install RMM
# Patch out -Werror
# Force the static logger dependencies to use the container's GCC toolchain instead of
# reusing ABI-incompatible shared libraries from Miniforge.
RUN git clone -b v${RAPIDS_VERSION}.00 https://github.com/rapidsai/rmm.git --recurse-submodules --depth 1 && \
    pushd rmm && \
    find . -name CMakeLists.txt -print0 | xargs -0 sed -i 's/-Werror//g' && \
    pushd cpp && \
    mkdir build && \
    pushd build && \
    cmake .. -GNinja -DCMAKE_INSTALL_PREFIX=/opt/rmm -DCUDA_STATIC_RUNTIME=ON \
      -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTS=OFF \
      -DCPM_DOWNLOAD_fmt=ON -DCPM_DOWNLOAD_spdlog=ON && \
    cmake --build . --target install && \
    popd && popd && popd && \
    rm -rf rmm /root/.cache

# Install lightweight sudo (not bound to TTY)
RUN sh /scripts/install_gosu.sh

# Default entry-point to use if running locally
# It will preserve attributes of created files
COPY entrypoint.sh /scripts/

WORKDIR /workspace
ENTRYPOINT ["/scripts/entrypoint.sh"]
