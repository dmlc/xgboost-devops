FROM ubuntu:22.04
ARG ARCH=x86_64
ARG MINIFORGE_VERSION=26.3.2-3

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/opt/miniforge/bin:$PATH
ENV CC=gcc-10
ENV CXX=g++-10
ENV CPP=cpp-10
ENV GOSU_VERSION=1.10
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64/

COPY scripts/install_gosu.sh conda_env/linux_cpu_test.yml /scripts/

# Keep system GCC and LLVM: sanitizer CI runs outside the Conda environment.
# Spark requires a Java runtime, but does not compile Java sources.
RUN \
    sed -i 's/ports.ubuntu.com/mirrors.ocf.berkeley.edu/g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install --no-install-recommends -y software-properties-common gpg-agent && \
    add-apt-repository ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    apt-get install --no-install-recommends -y tar unzip wget git build-essential doxygen graphviz llvm libidn12 cmake ninja-build gcc-10 g++-10 openjdk-17-jre-headless && \
    rm -rf /var/lib/apt/lists/* && \
    # Miniforge
    wget -nv -O conda.sh https://github.com/conda-forge/miniforge/releases/download/$MINIFORGE_VERSION/Miniforge3-$MINIFORGE_VERSION-Linux-${ARCH}.sh && \
    bash conda.sh -b -p /opt/miniforge && \
    rm conda.sh && \
    # Clean in the installation layer so earlier layers do not retain package caches.
    mamba install awscli -y && \
    mamba env create --file=/scripts/linux_cpu_test.yml -y && \
    mamba clean --all --yes && \
    # Environments use hard links here, so their files survive removal of the package cache.
    rm -rf /opt/miniforge/pkgs /root/.cache

# Install lightweight sudo (not bound to TTY)
RUN sh /scripts/install_gosu.sh

# Default entry-point to use if running locally
# It will preserve attributes of created files
COPY entrypoint.sh /scripts/

WORKDIR /workspace
ENTRYPOINT ["/scripts/entrypoint.sh"]
